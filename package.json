{
  "name": "dsh-dev-sandbox",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "DSH 沙箱管理面板：创建、查看、销毁与当前工作环境完全隔离的真实 DSH 实例",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "icon.svg",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
